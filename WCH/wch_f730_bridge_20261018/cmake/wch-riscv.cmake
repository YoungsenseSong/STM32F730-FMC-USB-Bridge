set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)

if(NOT DEFINED WCH_TOOLCHAIN_ROOT OR WCH_TOOLCHAIN_ROOT STREQUAL "")
  if(DEFINED ENV{WCH_TOOLCHAIN_ROOT})
    set(WCH_TOOLCHAIN_ROOT "$ENV{WCH_TOOLCHAIN_ROOT}")
  else()
    set(WCH_TOOLCHAIN_ROOT "C:/MounRiver/MounRiver_Studio/toolchain/RISC-V Embedded GCC12")
  endif()
endif()
set(WCH_TOOLCHAIN_ROOT "${WCH_TOOLCHAIN_ROOT}" CACHE PATH "MounRiver RISC-V GCC root")

if(NOT DEFINED WCH_TOOLCHAIN_PREFIX)
  set(WCH_TOOLCHAIN_PREFIX "riscv-none-elf" CACHE STRING "MounRiver RISC-V tool prefix")
endif()

set(CMAKE_C_COMPILER "${WCH_TOOLCHAIN_ROOT}/bin/${WCH_TOOLCHAIN_PREFIX}-gcc.exe")
set(CMAKE_ASM_COMPILER "${WCH_TOOLCHAIN_ROOT}/bin/${WCH_TOOLCHAIN_PREFIX}-gcc.exe")
set(CMAKE_OBJCOPY "${WCH_TOOLCHAIN_ROOT}/bin/${WCH_TOOLCHAIN_PREFIX}-objcopy.exe" CACHE FILEPATH "objcopy")
set(CMAKE_SIZE "${WCH_TOOLCHAIN_ROOT}/bin/${WCH_TOOLCHAIN_PREFIX}-size.exe" CACHE FILEPATH "size")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
